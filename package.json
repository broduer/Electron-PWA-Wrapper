{
  "name": "Avernic",
  "version": "1.0.0",
  "description": "Electron Desktop App for Avernic.com",
  "homepage": "https://www.leasingrechnen.at",
  "main": "index.js",
  "author": {
    "name": "xTools",
    "email": "apps@xtools.at"
  },
  "license": "NOUSAGE",
  "repository": {
    "type": "git",
    "url": "https://github.com/broduer/Electron-PWA-Wrapper.git"
  },
  "scripts": {
    "electron": "electron .",
    "start": "./node_modules/.bin/electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build": "./node_modules/.bin/electron-builder build",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "~1.7.12",
    "electron-builder": "^19.55.3"
  },
  "dependencies": {},
  "files": [
    "*.js",
    "src",
    "node_modules"
  ],
  "build": {
    "appId": "com.avernic.desktop",
    "productName": "Avernic",
    "copyright": "Copyright © 2025 avernic.com",
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "mas"
        }
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {},
    "mas": {},
    "win": {
      "target": [
        {
          "target": "appx"
        },
        {
          "target": "portable"
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Copyright © 2025 avernic.com",
      "publisherName": "broduer"
    },
    "appx": {
      "applicationId": "com.avernic.desktop",
      "backgroundColor": "#F44336",
      "displayName": "Avernic",
      "identityName": "22127avernic.com",
      "publisher": "CN=84B32E2F-0B83-4D35-8A43-109EF795E8E1",
      "publisherDisplayName": "broduer",
      "languages": [
        "en"
      ]
    },
    "portable": {},
    "linux": {
      "target": [
        {
          "target": "AppImage"
        }
      ],
      "maintainer": "broduer",
      "vendor": "avernic.com",
      "synopsis": "Avernic App",
      "category": "Office"
    },
    "appImage": {
      "systemIntegration": "doNotAsk"
    }
  }
}
